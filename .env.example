# Machine-specific configuration for genagents.
# Copy to .env, fill in, then load with:  set -a; source .env; set +a
# All variables are optional; defaults are shown. See simulation_engine/settings.py.

# --- Model provider: "local" (HF transformers on this machine) or "openai"
GENAGENTS_PROVIDER=local

# --- Local model to use (key of MODEL_REGISTRY in simulation_engine/settings.py)
#     14b | 7b | llama3.1-8b | mistral-nemo-2407 | gemma-3-12b-it | ministral-3-14b-instruct-2512 | 32b | 32b-gptq
GENAGENTS_MODEL=14b

# --- Directory with downloaded model weights (one folder per model, see download_models.py).
#     Leave empty to load from the Hugging Face hub / HF cache instead.
GENAGENTS_MODELS_DIR=

# --- GPU selection: "cuda" auto-picks the GPU with most free memory; or cuda:N / cpu / mps
GENAGENTS_DEVICE=cuda

# --- Sentence-transformers model used for memory embeddings
GENAGENTS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Where agent populations live (defaults to <repo>/agent_bank/populations)
GENAGENTS_POPULATIONS_DIR=

# --- Print every prompt/response pair (1 = on)
GENAGENTS_DEBUG=0

# --- Credentials
HF_TOKEN=
OPENAI_API_KEY=
GENAGENTS_OPENAI_MODEL=gpt-5-mini

# --- Standard Hugging Face cache location (optional)
# HF_HOME=
